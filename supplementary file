typedef struct
{
	char** items;
	int index;
	int capacity;
} stringVect;

void initialize(stringVect* ptr)
{
	ptr->index = 0;
	ptr->capacity = 3;
	ptr->items = malloc(sizeof(char*) * ptr->capacity);
}


void addString(stringVect* ptr, char* buffer)
{
	size_t len = strlen(buffer) + 1;
	ptr->items[ptr->index] = malloc(len);
	strncpy(ptr->items[ptr->index++], buffer, len);
}



