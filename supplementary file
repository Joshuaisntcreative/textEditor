void swapString(stringVect* ptr, int loc1, int loc2)
{

	size_t len1 = strlen(ptr->items[loc1]);
	size_t len2 = strlen(ptr->items[loc2]);
	//need to store one strings data in a temporary pointer so it doesnt get lost, we'll store string1 in a temp 

	//4 btyes are already in play
	char* temp = malloc(len1 - 4);

	//temp is now string1 
	strncpy(temp, ptr->items[loc1], len1);
	//string 2 has enough space for string1
	char* temp1 = realloc(ptr->items[loc2], len1);

	//string1 has enough space for string2

	char* temp2 = realloc(ptr->items[loc1], len2);

	ptr->items[loc1] = temp2;
	ptr->items[loc1] = ptr->items[loc2];

	ptr->items[loc2] = temp1;
	ptr->items[loc2] = temp;

}

typedef struct {
	SDL_Window* mWindow;
	bool mRunning;
	SDL_Renderer* mRenderer;
	int wM, hM;

}SDLApplication;

//ill also add the drawable stuff here so its readable
typedef struct {
	TTF_Font* mFont;
	SDL_Color mColor;
	SDL_Surface* mSurface;
	char* mText;
	SDL_Texture* mTexture;
	float mWidth, mHeight;
	SDL_FRect mDst;
} Drawable;

//initialize every drawable to white rockwell for now
void initializeDrawable(Drawable* dwblP, char* string, int x, int y)
{
	SDL_Color white = { 255, 255, 255, 255 };
	dwblP->mColor = white;

	dwblP->mFont = TTF_OpenFont("font/Rockwell.otf", 20);
	if (!dwblP->mFont)
	{
		printf("Font loading failed: %s\n", SDL_GetError());
		return;
	}
	dwblP->mText = string;
	dwblP->mSurface = TTF_RenderText_Blended(dwblP->mFont, dwblP->mText, 0, white);
	if (!dwblP->mSurface)
	{
		printf("%s\n", SDL_GetError());
		return 1;
	}
	dwblP->mWidth = (float)(dwblP->mSurface)->w;
	dwblP->mHeight = (float)(dwblP->mSurface)->h;
	SDL_FRect dst = {
	x,
	y,
	dwblP->mWidth,
	dwblP->mHeight
	};
	dwblP->mDst = dst;

}
void destroyDrawable(Drawable* dwblP)
{
	SDL_DestroyTexture(dwblP->mTexture);
	TTF_CloseFont(dwblP->mFont);

	dwblP->mTexture = NULL;
	dwblP->mFont = NULL;
}
void linkDrawable(SDLApplication* sdlP, Drawable* dwblP)
{

	dwblP->mTexture =
		SDL_CreateTextureFromSurface(sdlP->mRenderer, dwblP->mSurface);

	if (!dwblP->mTexture)
	{
		printf("Texture creation failed: %s\n", SDL_GetError());
		return;
	}


	SDL_DestroySurface(dwblP->mSurface);
	dwblP->mSurface = NULL;

}

void updateFrame(SDLApplication* sdlP)
{

	SDL_RenderPresent(sdlP->mRenderer);
}
void renderDrawable(SDLApplication* sdlP, Drawable* dwblP)
{
	SDL_RenderTexture(sdlP->mRenderer, dwblP->mTexture, NULL, &(dwblP->mDst));
}

void updateDrawable(SDLApplication* sdlP, Drawable* dwblP, char* string)
{
	dwblP->mText = string;

	SDL_DestroyTexture(dwblP->mTexture);

	dwblP->mSurface =
		TTF_RenderText_Blended(
			dwblP->mFont,
			dwblP->mText,
			0,
			dwblP->mColor
		);

	dwblP->mTexture =
		SDL_CreateTextureFromSurface(
			sdlP->mRenderer,
			dwblP->mSurface
		);

	dwblP->mWidth = (float)dwblP->mSurface->w;
	dwblP->mHeight = (float)dwblP->mSurface->h;


	dwblP->mDst.w = dwblP->mWidth;
	dwblP->mDst.h = dwblP->mHeight;

	SDL_DestroySurface(dwblP->mSurface);
}


void renderScreen(SDLApplication* sdlP)
{
	SDL_SetRenderDrawColor(sdlP->mRenderer, 30, 30, 30, 255);
	SDL_RenderClear(sdlP->mRenderer);
}



void initializeSDL3(SDLApplication* sdlP)
{
	SDL_Init(SDL_INIT_VIDEO);
	sdlP->mRunning = false;
	int w = 640, h = 480;
	sdlP->wM = w;
	sdlP->hM = h;
	sdlP->mWindow = SDL_CreateWindow("SDL3 window", w, h, SDL_WINDOW_OPENGL);

	if (sdlP->mWindow == NULL)
	{
		SDL_LogError(SDL_LOG_CATEGORY_ERROR, "Could not create window: %s\n", SDL_GetError());
		return 1;
	}

	if (!TTF_Init()) {
		printf("TTF Init failed: %s\n", SDL_GetError());
		return 1;
	}


}


void drawStringVect(SDLApplication* sdlP, stringVect* strVp)
{
	TTF_Init();
	TTF_Font* font = TTF_OpenFont("font/Rockwell.otf", 32);
	SDL_Color white = { 255,255,255,255 };

	SDL_Surface* surface = TTF_RenderText_Blended(font, strVp->items[0], 0, white);
	SDL_Texture* texture = SDL_CreateTextureFromSurface(sdlP->mRenderer, surface);

	SDL_DestroySurface(surface);

	SDL_FRect dst =
	{
		40,70, 200, 250
	};

	SDL_RenderTexture(sdlP->mRenderer, texture, NULL, &dst);
	SDL_RenderPresent(sdlP->mRenderer);
}

void sdlRunning(SDLApplication* sdlP)
{

	//creating window
	SDL_Renderer* renderer = SDL_CreateRenderer(sdlP->mWindow, NULL);
	if (!renderer)
	{
		printf("Renderer creation failed: %s\n", SDL_GetError());
		return 1;
	}


	Drawable d1;
	Drawable* d1P = &d1;


	//rendering
	sdlP->mRenderer = renderer;




	//initializing stringVector pointer W buffer = 256
	char buffer[256] = "";
	stringVect strV;
	stringVect* strVp = &strV;
	initialize(strVp);



	SDL_StartTextInput(sdlP->mWindow);



	addString(strVp, buffer);


	initializeDrawable(d1P, "hello", 150, 100);
	linkDrawable(sdlP, d1P);
	//main window loop
	while (!sdlP->mRunning)
	{
		SDL_Event event;
		while (SDL_PollEvent(&event)) {
			if (event.type == SDL_EVENT_QUIT) {
				sdlP->mRunning = true;
				break;
			}

			if (event.type == SDL_EVENT_TEXT_INPUT)
			{
				strcat(buffer, event.text.text);
				printf("%s\n", buffer);
				append_charptr(strVp, 0, event.text.text);
				updateDrawable(sdlP, d1P, strVp->items[0]);
				printAll(strVp);
			}
			
		}
		renderScreen(sdlP);
		renderDrawable(sdlP, d1P);
		updateFrame(sdlP);

	}
	SDL_DestroyRenderer(renderer);
	SDL_StopTextInput(sdlP->mWindow);
	SDL_DestroyWindow(sdlP->mWindow);
	TTF_Quit();
	SDL_Quit();

}


